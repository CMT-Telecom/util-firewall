$TTL 2h
@ IN SOA localhost. root.localhost. (
    2026081701 ; Serial (AUMENTE ESSE NUMERO SEMPRE QUE ATUALIZAR A LISTA)
    2h         ; Refresh
    15m        ; Retry
    30d        ; Expire
    2h         ; Minimum TTL
)
  IN NS  localhost.

